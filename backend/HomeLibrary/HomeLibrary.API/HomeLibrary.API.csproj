      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.VisualStudio.Azure.Containers.Tools.Targets" Version="1.24.2-preview.1" />
    <PackageReference Include="RabbitMQ.Client" Version="7.2.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\HomeLibrary.Contracts\HomeLibrary.Contracts.csproj" />
    <ProjectReference Include="..\HomeLibrary.Persistence\HomeLibrary.Persistence.csproj" />
  </ItemGroup>

</Project>
